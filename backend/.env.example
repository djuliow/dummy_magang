PORT=3000
DEFAULT_SENSOR_PH=6.8
DEFAULT_SENSOR_TEMPERATURE=24
DEFAULT_NODE_NAME=SoilMonitoringESP8266
DEFAULT_NODE_LOCATION=Field Sector A

# Optional for temporary deployment.
# If these are left blank, backend will still accept sensor data
# and store it in local-data.json while the Railway instance is alive.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
